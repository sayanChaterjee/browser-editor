  "version": "1.0.0",
  "description": "Contests: contest admin, submissions and anti-cheat strikes",
  "main": "src/app.ts",
  "scripts": {
    "start": "ts-node src/app.ts",
    "dev": "ts-node-dev src/app.ts",
