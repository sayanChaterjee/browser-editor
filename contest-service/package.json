    "winston": "^3.17.0",
    "zod": "^3.24.2",
    "@ceditor/common": "*",
    "@ceditor/contracts": "*"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
