# Local development (npm run dev). docker compose overrides infra addresses.
PORT=3004
NODE_ENV=development
LOG_LEVEL=info
# Bearer token for /metrics; unset = endpoint disabled (docker compose sets a local one)
METRICS_TOKEN=
INTERNAL_GATEWAY_SECRET=same-value-in-every-service
# Verifies the user tokens the gateway signs (local pair; matches the gateway's private key)
USER_TOKEN_PUBLIC_KEY=MCowBQYDK2VwAyEAvlgUysilcyUjQ/51QtLz4ySZBa5SXR5RqjykPQEQHyk=

DATABASE_URL=mongodb://localhost:27017/ceditor_contest
# Local: compose Kafka on 9094. Production: Aiven broker, certs in ./certs (dev) or /etc/secrets (prod)
KAFKA_BROKER=localhost:9094

ADMIN_EMAILS=you@example.com
