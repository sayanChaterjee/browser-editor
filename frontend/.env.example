# API gateway URL used by the /api proxy (server-side). Production: your Render gateway URL.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Shared with the API gateway's BFF_SHARED_SECRET (server-only, never NEXT_PUBLIC)
BFF_SHARED_SECRET=generate-with-openssl-rand-base64-32
# Show the username/password forms (local development). Off in production: Google only
# (identity-service's EMAIL_PASSWORD_AUTH must match)
NEXT_PUBLIC_EMAIL_PASSWORD_AUTH=true
