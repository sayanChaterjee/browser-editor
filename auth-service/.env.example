# Local development (npm run dev). docker compose overrides infra addresses.
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# Bearer token for /metrics; unset = endpoint disabled (docker compose sets a local one)
METRICS_TOKEN=
INTERNAL_GATEWAY_SECRET=same-value-in-every-service

DATABASE_URL=mongodb://localhost:27017/ceditor_auth
REDIS_URL=redis://localhost:6379
# Local: compose Kafka on 9094. Production: Aiven broker, certs in ./certs (dev) or /etc/secrets (prod)
KAFKA_BROKER=localhost:9094

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Public frontend URL (requests reach auth through the Next.js /api proxy)
BETTER_AUTH_URL=http://localhost:3005
FRONTEND_URL=http://localhost:3005
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
RESEND_API_KEY=

USER_SERVICE_URL=http://localhost:3002
CODE_SERVICE_URL=http://localhost:3003
