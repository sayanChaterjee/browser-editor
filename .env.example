# Shared secrets for docker compose (local development). Copy to .env.
# Infra addresses (Mongo/Redis/Kafka/service URLs) are set in docker-compose.yml.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
INTERNAL_GATEWAY_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
RESEND_API_KEY=
ADMIN_EMAILS=you@example.com
