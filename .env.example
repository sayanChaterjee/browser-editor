# Shared secrets for docker compose (local development). Copy to .env.
# Infra addresses (Mongo/Redis/Kafka/service URLs) are set in docker-compose.yml.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
INTERNAL_GATEWAY_SECRET=generate-with-openssl-rand-base64-32
# Signs/verifies the user identity the gateway passes to the services. This pair is for local
# development only (production uses its own; see render.yaml). New pair: npm run keys:user-token
USER_TOKEN_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIMIpmGrWPqkOxoDkiwPMCiDdarxLusukpW4+8aOOQNme
USER_TOKEN_PUBLIC_KEY=MCowBQYDK2VwAyEAvlgUysilcyUjQ/51QtLz4ySZBa5SXR5RqjykPQEQHyk=
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
ADMIN_EMAILS=you@example.com
