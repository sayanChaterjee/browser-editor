# Local development (npm run dev). docker compose overrides infra addresses.
PORT=3001
NODE_ENV=development
LOG_LEVEL=info
# Bearer token for /metrics; unset = endpoint disabled (docker compose sets a local one)
METRICS_TOKEN=
INTERNAL_GATEWAY_SECRET=same-value-in-every-service
# Verifies the user tokens the gateway signs (local pair; matches the gateway's private key)
USER_TOKEN_PUBLIC_KEY=MCowBQYDK2VwAyEAvlgUysilcyUjQ/51QtLz4ySZBa5SXR5RqjykPQEQHyk=

DATABASE_URL=mongodb://localhost:27017/ceditor_auth
REDIS_URL=redis://localhost:6379
# Local: compose Kafka on 9094. Production: Aiven broker, certs in ./certs (dev) or /etc/secrets (prod)
KAFKA_BROKER=localhost:9094

BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# Public frontend URL (requests reach auth through the Next.js /api proxy)
BETTER_AUTH_URL=http://localhost:3005
FRONTEND_URL=http://localhost:3005
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Owners (comma-separated): always admins, can't be demoted or banned. Other admins are
# promoted from the admin page (the role travels to the services in the signed user token).
ADMIN_EMAILS=you@example.com

# Failed sign-ins per email address before it is locked for LOGIN_LOCKOUT_MINUTES
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# Username/password sign-up and sign-in (off in production: Google only)
EMAIL_PASSWORD_AUTH=true
