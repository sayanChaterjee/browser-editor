# Local development (npm run dev). docker compose overrides infra addresses.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Bearer token for /metrics; unset = endpoint disabled (docker compose sets a local one)
METRICS_TOKEN=
DEFAULT_TIMEOUT=30000
INTERNAL_GATEWAY_SECRET=same-value-in-every-service

REDIS_URL=redis://localhost:6379

AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
CODE_SERVICE_URL=http://localhost:3003

# Production: your Vercel URL
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3000

# Client IP for rate limiting: the frontend /api proxy vouches for it with this shared secret.
BFF_SHARED_SECRET=same-value-as-frontend-BFF_SHARED_SECRET
# true only behind Cloudflare (Render), which overwrites CF-Connecting-IP
TRUST_CF_CONNECTING_IP=false
# Proxies whose X-Forwarded-For is trusted for req.ip (0 = ignore the header)
TRUST_PROXY_HOPS=0
RATE_LIMIT_IP_PER_MINUTE=600
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_15_MINUTES=20
