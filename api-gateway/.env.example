PORT=3000
SERVICE_NAME=api-gateway
NODE_ENV=development

DEFAULT_TIMEOUT=30000

RATE_LIMIT_WINDOW=
RATE_LIMIT_MAX_REQUESTS=

LOG_LEVEL=info
INTERNAL_GATEWAY_SECRET=your_shared_secret_here

REDIS_URL=redis://localhost:6379

AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
CODE_SERVICE_URL=http://code-service:3003

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3004,http://localhost:3005
